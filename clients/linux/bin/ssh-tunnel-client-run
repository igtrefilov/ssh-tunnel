#!/usr/bin/env bash
set -Eeuo pipefail

die() {
    printf 'ssh-tunnel client: %s\n' "$*" >&2
    exit 1
}

(( $# == 1 )) || die "expected one profile name"
profile=$1
[[ $profile =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] || die "invalid profile: $profile"

config_root=${XDG_CONFIG_HOME:-$HOME/.config}
profile_file=$config_root/ssh-tunnel/client/$profile.env
[[ -r $profile_file ]] || die "profile does not exist: $profile_file"

# Generated by install.sh, owned by this user and mode 0600.
# shellcheck disable=SC1090
source "$profile_file"

required_variables=(
    ROUTE_MODE SERVER_HOST SERVER_PORT SERVER_USER
    LOCAL_SOCKS_ADDRESS LOCAL_SOCKS_PORT
    REMOTE_SOCKS_ADDRESS REMOTE_SOCKS_PORT
    IDENTITY_FILE SERVER_KNOWN_HOSTS_FILE
)
for variable_name in "${required_variables[@]}"; do
    [[ -n ${!variable_name:-} ]] || die "missing $variable_name in $profile_file"
done
[[ $ROUTE_MODE == direct || $ROUTE_MODE == jump ]] || die "invalid ROUTE_MODE"
for numeric_port in "$SERVER_PORT" "$LOCAL_SOCKS_PORT" "$REMOTE_SOCKS_PORT"; do
    [[ $numeric_port =~ ^[0-9]+$ ]] && (( 1 <= 10#$numeric_port && 10#$numeric_port <= 65535 )) ||
        die "invalid port in $profile_file: $numeric_port"
done
[[ -r $IDENTITY_FILE ]] || die "identity is not readable: $IDENTITY_FILE"
[[ -r $SERVER_KNOWN_HOSTS_FILE ]] ||
    die "server known-hosts file is not readable: $SERVER_KNOWN_HOSTS_FILE"

ssh_args=(
    -F /dev/null
    -N
    -T
    -i "$IDENTITY_FILE"
    -p "$SERVER_PORT"
    -o BatchMode=yes
    -o IdentitiesOnly=yes
    -o PreferredAuthentications=publickey
    -o PasswordAuthentication=no
    -o KbdInteractiveAuthentication=no
    -o ExitOnForwardFailure=yes
    -o ServerAliveInterval=30
    -o ServerAliveCountMax=3
    -o TCPKeepAlive=yes
    -o StrictHostKeyChecking=yes
    -o GlobalKnownHostsFile=/dev/null
    -o UserKnownHostsFile="$SERVER_KNOWN_HOSTS_FILE"
    -o ForwardAgent=no
)

if [[ $ROUTE_MODE == jump ]]; then
    jump_variables=(JUMP_HOST JUMP_PORT JUMP_USER JUMP_IDENTITY_FILE JUMP_KNOWN_HOSTS_FILE)
    for variable_name in "${jump_variables[@]}"; do
        [[ -n ${!variable_name:-} ]] || die "missing $variable_name for jump route"
    done
    [[ $JUMP_PORT =~ ^[0-9]+$ ]] && (( 1 <= 10#$JUMP_PORT && 10#$JUMP_PORT <= 65535 )) ||
        die "invalid jump port: $JUMP_PORT"
    [[ -r $JUMP_IDENTITY_FILE ]] || die "jump identity is not readable: $JUMP_IDENTITY_FILE"
    [[ -r $JUMP_KNOWN_HOSTS_FILE ]] || die "jump known-hosts file is not readable"

    proxy_command_args=(
        /usr/bin/ssh
        -F /dev/null
        -W '%h:%p'
        -i "$JUMP_IDENTITY_FILE"
        -p "$JUMP_PORT"
        -o BatchMode=yes
        -o ConnectTimeout=10
        -o IdentitiesOnly=yes
        -o PreferredAuthentications=publickey
        -o PasswordAuthentication=no
        -o KbdInteractiveAuthentication=no
        -o StrictHostKeyChecking=yes
        -o GlobalKnownHostsFile=/dev/null
        -o UserKnownHostsFile="$JUMP_KNOWN_HOSTS_FILE"
        -o ForwardAgent=no
        "$JUMP_USER@$JUMP_HOST"
    )
    printf -v proxy_command '%q ' "${proxy_command_args[@]}"
    proxy_command=${proxy_command% }
    ssh_args+=( -o "ProxyCommand=$proxy_command" )
fi

ssh_args+=(
    -L "$LOCAL_SOCKS_ADDRESS:$LOCAL_SOCKS_PORT:$REMOTE_SOCKS_ADDRESS:$REMOTE_SOCKS_PORT"
    "$SERVER_USER@$SERVER_HOST"
)

exec /usr/bin/ssh "${ssh_args[@]}"

[Unit]
Description=SSH Tunnel Gateway dedicated SSH endpoint
After=network-online.target ssh-tunnel-socks.service
Wants=network-online.target
Requires=ssh-tunnel-socks.service

[Service]
Type=simple
RuntimeDirectory=ssh-tunnel
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=restart
ExecStartPre=@SSHD_BIN@ -t -f /etc/ssh-tunnel/sshd_config
ExecStart=@SSHD_BIN@ -D -e -f /etc/ssh-tunnel/sshd_config
ExecReload=/bin/kill -HUP $MAINPID
KillMode=process
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=multi-user.target
